# ---- Servidor ----
NODE_ENV=development
PORT=3333
API_PREFIX=/api
CORS_ORIGIN=http://localhost:3000

# ---- Banco (PostgreSQL) ----
DATABASE_URL=postgres://usuario:senha@localhost:5432/mysessions
DB_SSL=false
DB_LOGGING=false

# ---- Autenticação ----
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_EXPIRES_IN=7d

# ---- OpenAI (redação dos relatórios) ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_MS=60000
OPENAI_MAX_RETRIES=2
# Opcional: gateway/proxy compatível com a API da OpenAI
OPENAI_BASE_URL=

# ---- Relatórios ----
# Gera o relatório da semana sozinho quando o último dia de atendimento é finalizado
AUTO_GENERATE_REPORT=true
REPORTS_STORAGE_DIR=./storage/reports
# Logo no topo do relatório (PNG/JPG). Vazio = logo padrão em src/assets
REPORT_LOGO_PATH=
# Cabeçalho fixo do documento (como no original; não é preenchido no app)
REPORT_SCHOOL_NAME=Soma Garden
REPORT_MONITOR_NAME=Diana Souza
REPORT_SUPERVISOR_NAME=Isabela Navarro
# Caminho do LibreOffice usado para converter DOCX em PDF
SOFFICE_BIN=soffice
SOFFICE_TIMEOUT_MS=90000

# ---- Limite de requisições ----
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# ---- Seed (npm run seed) ----
# Senha PROVISÓRIA da conta da Amanda (mín. 8). Vazio = uma é sorteada e mostrada uma vez no console.
# Ela define a própria senha no primeiro acesso.
SEED_TEMP_PASSWORD=

# ---- Face ID / biometria (WebAuthn) ----
# RP ID = domínio do APP sem porta (ex.: app.seudominio.com.br); ORIGIN = endereço completo do app (HTTPS em produção)
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Neuro Acompanha
WEBAUTHN_ORIGIN=http://localhost:3000
